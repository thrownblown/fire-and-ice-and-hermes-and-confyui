# Media is derived from a local rip and never committed. Metadata that
# sits beside it (json, jsonl, txt, md, srt) stays tracked.
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.wav
*.flac
*.mp3
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff

# Environments and caches
.venv/
.venv-demucs/
.pytest_cache/
__pycache__/
*.pyc
.worktrees/

# Third-party clones; each is its own repo
explore/

# Scratch and run logs
scratch/
*.log
*.err
tmp_*.json
# Local scratch (node/jsdom test harness, extracted audio, temp graphs)
.tmp/

# Saved web pages and their asset dumps
*.html
*_files/

# Image formats that slipped the first pass
*.avif

# The source master, by name, in case the extension rule is ever loosened
Fire.And.Ice*.mp4

# the SPA markup IS source — version it (handoffs asked twice)
!browser/index.html

# Model inventories and LoRA catalogs. These are generated dumps of the
# ComfyUI model store on tombstone and carry third-party model names,
# including adult ones. They are regenerable state, not work — never commit
# them (purged from history 2026-10-30; see tools/spicy_check.py).
manifests/lora_catalog_*.jsonl
manifests/lora_sort_*.jsonl
renders/*/INVENTORY.json
renders/*/INVENTORY.md
# ComfyUI API dumps — the 5090's /history and /object_info embed model
# filenames (and therefore the adult LoRA names) at 12 MB of noise
renders/*/object_info.json
renders/*/history.json
*.safetensors

# The content guard itself is kept LOCAL: its HARD regexes spell out the vocabulary they
# block, so the file is not versioned. It lives in a working clone and protects it; a fresh
# clone simply has no guard (the pre-commit hook degrades to a no-op).
tools/spicy_check.py
tools/spicy_check.py.bak

# A saved ComfyUI UI workflow that embeds ~96 LoRA filenames (~14500 lines of nodes);
# it is not runnable by our API path and is the biggest source of adult-vocabulary hits.
corpus/2_low_mm_20260925_091204_00001-audio.json

# Pre-rewrite bundles hold the old history; never commit them
.backups/

# vendored browser test deps (jsdom harness) — regenerable, never commit
browser/node_modules/

# The source subtitle rips are the only files here that are not our own work: both are complete
# transcriptions of the film's dialogue. The ASR output, the timeline and the prompts are our own
# derivative artifacts and stay; these two are raw copies, so they live on disk only.
audio/Fire.and.Ice.1983.1080-en.srt
script/fire-and-ice-1983.srt

# A stale throwaway probe holding an explicit prompt line. Not referenced by anything.
probes/krea2_5090_template.json

# Real rig addresses/paths, this box only (the tracked docs carry placeholders)
docs/rig-addresses.local.md

# The source transcripts of the dialogue: a full reproduction of the film's spoken script, the same
# class as the subtitle rips. Both are load-bearing locally (the pipeline reads the timeline's text
# column to build prompts) and both stay on disk untracked — a fresh clone gets the derivative prompts,
# which quote individual lines, but not a complete script.
script/dialogue-timeline.tsv
audio/asr_segments.jsonl
